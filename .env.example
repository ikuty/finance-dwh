# compose/docker-compose.yml が読む設定。compose/.env にコピーして使う。

# レイク(finance-lake)のデータディレクトリ。postgres コンテナに /lake:ro で mount される。
#   ローカル : テスト用の合成ツリー
#   Mac Mini : LAKE_DIR=/home/ikuty/finance-lake/data
LAKE_DIR=/tmp/lake-sample

# Postgres の資格情報・DB 名（初回起動時に作成される）
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance_dwh
POSTGRES_PORT=5432

# Postgres データディレクトリ（bind mount）。compose ファイルからの相対パス、または絶対パス。
#   Mac Mini : PGDATA_DIR=/home/ikuty/finance-dwh/data/pgdata
PGDATA_DIR=../data/pgdata

# dbt のターゲット（prod / ci）
DBT_TARGET=prod

# 実行レポートの公開・通知（未設定なら該当ステップをスキップ）。
# S3 バケット・IAM は finance-lake と共用（バケット ikuty-finance、キー finance-dwh/run_report.html）。
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
SLACK_WEBHOOK_URL=

