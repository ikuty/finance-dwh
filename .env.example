# compose/docker-compose.yml が読む設定。compose/.env にコピーして使う。

# レイク(finance-lake)のデータディレクトリ。transform コンテナに /lake:ro で mount される。
#   ローカル : テスト用のサンプルツリー
#   Mac Mini : LAKE_DIR=/home/ikuty/finance-lake/data
LAKE_DIR=/tmp/fdwh-lake

# .duckdb カタログ・landing・cleansed の Parquet を永続化するホスト側ディレクトリ。
# compose ファイルからの相対パス、または絶対パス。
#   Mac Mini : DATA_DIR=/home/ikuty/finance-dwh/data
DATA_DIR=../data

# dbt のターゲット（prod / ci）
DBT_TARGET=prod

# landing への日付単位 load で、直近何日を毎回取り込み直すか（edinet-dl の DAYS_WINDOW を包含）
LANDING_LOOKBACK_DAYS=7

# 実行レポートの公開・通知（未設定なら該当ステップをスキップ）。
# S3 バケット・IAM は finance-lake と共用（バケット ikuty-finance、キー finance-dwh/run_report.html）。
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
SLACK_WEBHOOK_URL=
