# Mac Miniホスト（Ubuntu 24.04 LTS）に配置する systemd ユニットの例。
# /etc/systemd/system/finance-dwh-transform.service にコピーする
# （finance-dwh-transform.timer と対で使う）。
#
# 日次: レイクの取得ジョブ（edinet-dl / jpx-daily-pdf-dl）が終わってから
# `docker compose run --rm transform` で Prefect フローを回す
# （landing 取り込み → dbt build（DuckDB）→ 実行レポート生成 → S3 → Slack）。
#
# DuckDB は組み込み型（サーバなし）のため、常駐させる依存サービスは無い
# （旧 Postgres 版にあった finance-dwh-postgres.service は廃止した）。
#
# After= に edinet-dl.service / jpx-daily-pdf-dl.service を列挙するのは純粋な順序制約
# （実行中なら待つ、未実行なら待たない。Requires=/Wants= は付けない）。raw 層は
# レイクのファイルを DuckDB で直読みするため、取得ジョブが当日ぶんを書き終えてから
# 走らせたい。
#
# マシンのシャットダウンはこのユニットでは行わない。finance-lake の共有シャットダウン
# ユニット（finance-lake/systemd/finance-lake-shutdown.service）が全ジョブ完了後に
# 一手に引き受ける。そのユニットの After= 行には finance-dwh-transform.service が
# 既に追記済み（finance-dwh-postgres.service への参照はそもそも含まれていないため、
# この撤去にあたって finance-lake 側の変更は不要）。
#
# 有効化:
#   sudo systemctl daemon-reload
#   sudo systemctl enable finance-dwh-transform.timer
#   sudo systemctl start finance-dwh-transform.timer
#   journalctl -u finance-dwh-transform.service

[Unit]
Description=finance-dwh daily transform (dbt build + run report + Slack)
After=network-online.target docker.service edinet-dl.service jpx-daily-pdf-dl.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ikuty/finance-dwh/compose
ExecStart=/usr/bin/docker compose run --rm transform
