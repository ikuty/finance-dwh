# Mac Miniホスト（Ubuntu 24.04 LTS）に配置する systemd ユニットの例。
# /etc/systemd/system/finance-dwh-postgres.service にコピーする。
#
# 通電枠（Tapo スマートプラグで 04:00-06:00 JST）のあいだ、DWH の PostgreSQL を
# 起動しっぱなしにする oneshot ユニット。transform ジョブ
# （finance-dwh-transform.service）はここへ `docker compose run` で都度接続する。
#
# finance-lake の各サービスは「コンテナ内にデーモンを置かない」方針だが、PostgreSQL は
# 本質的に常駐プロセスなので、compose で up したものを RemainAfterExit=yes で
# 「起動済み」扱いにする。マシン停止時に ExecStop で明示的に stop する
# （HDD 上の pgdata を綺麗に閉じるため）。
#
# 前提（deploy 時に用意する。docs/deployment_design.md 参照）:
#   - /home/ikuty/finance-dwh をチェックアウト済み
#   - /home/ikuty/finance-dwh/compose/.env に LAKE_DIR=/home/ikuty/finance-lake/data、
#     PGDATA_DIR=/home/ikuty/finance-dwh/data/pgdata、POSTGRES_* 、S3/Slack を設定済み
#   - `docker compose build` 済み（またはイメージを pull 済み）
#
# 有効化:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now finance-dwh-postgres.service
#   systemctl status finance-dwh-postgres.service

[Unit]
Description=finance-dwh PostgreSQL (raw layer via file_fdw)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ikuty/finance-dwh/compose
ExecStart=/usr/bin/docker compose up -d postgres
ExecStop=/usr/bin/docker compose stop postgres

[Install]
WantedBy=multi-user.target
